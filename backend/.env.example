# Settings for the Student Performance Prediction System.
# Copy this file to backend\.env, remove the # in front of a line and change its value.
# The system reads the file when it starts, so restart it after any change.

# The current academic session and semester (First or Second).
# SAPPS_CURRENT_SESSION=2025/2026
# SAPPS_CURRENT_SEMESTER=First

# Where the data lives. Default: the SQLite file backend\data\app.db.
# For PostgreSQL, install the driver first (.venv\Scripts\python.exe -m pip install "psycopg[binary]").
# SAPPS_DATABASE_URL=postgresql+psycopg://user:password@server/sapps

# Signs the session cookies. If unset, a random key is created in backend\data\secret.key.
# Changing it signs everyone out.
# SAPPS_SECRET_KEY=

# How long a session lasts, in hours.
# SAPPS_TOKEN_HOURS=8

# Set to true when the system is served over HTTPS.
# SAPPS_COOKIE_SECURE=false
